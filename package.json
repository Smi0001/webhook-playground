{
  "name": "webhook-playground",
  "version": "2.0.0",
  "description": "Self-hosted webhook inspection and testing tool — capture, inspect, and debug incoming HTTP requests in real time",
  "main": "src/app.js",
  "bin": {
    "webhook-play": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "migrations/",
    ".env.example"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "dev": "nodemon bin/cli.js",
    "migrate": "node bin/cli.js migrate"
  },
  "keywords": [
    "webhook",
    "inspector",
    "http",
    "debugger",
    "testing",
    "devtools",
    "microservice",
    "sse",
    "real-time"
  ],
  "license": "MIT",
  "author": "Shammi Hans",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "pg": "^8.11.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
